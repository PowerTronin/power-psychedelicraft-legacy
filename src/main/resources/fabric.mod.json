{
  "schemaVersion": 1,
  "id": "psychedelicraft",
  "version": "${version}",
  "name": "Power Psychedelicraft Legacy",
  "description": "A legacy-focused Fabric 1.20.1 fork of Psychedelicraft, based on the original mod by Ivorius and maintainers.",
  "authors": [
    "Ivorius", "TripleHeadedSheep", "Sollace"
  ],
  "contact": {
    "homepage": "http://www.minecraftforum.net/topic/563257-152"
  },
  "license": "MIT",
  "icon": "logo.png",
  "accessWidener": "psychedelicraft.aw",
  "environment": "*",
  "entrypoints": {
    "main": [
      "ivorius.psychedelicraft.Psychedelicraft"
    ],
    "client": [
      "ivorius.psychedelicraft.client.PsychedelicraftClient"
    ],
    "fabric-datagen": [
      "ivorius.psychedelicraft.datagen.Datagen"
    ],
    "tla-api": [
      "ivorius.psychedelicraft.compat.tia.Main"
    ],
    "modmenu": [
      "ivorius.psychedelicraft.compat.modmenu.Main"
    ]
  },
  "mixins": [
    "psychedelicraft.mixin.json"
  ],
  "depends": {
    "minecraft": "${minecraftVersion}",
    "fabricloader": "${loaderVersion}",
    "java": ">=17",
    "fabric-api": "${fabricVersion}"
  },
  "suggests": {
    "modmenu": "*"
  },
  "conflicts": {
    "kubejs": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/mt7uwQ4",
        "modmenu.original_project": "https://github.com/Sollace/Psychedelicraft"
      }
    }
  }
}
